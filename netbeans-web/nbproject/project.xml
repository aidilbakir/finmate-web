                    <path-in-war>WEB-INF/lib/jjwt-gson-0.12.3.jar</path-in-war>
                </library>
                <library dirs="200">
                    <file>${file.reference.jjwt-impl-0.12.3.jar}</file>
                    <path-in-war>WEB-INF/lib/jjwt-impl-0.12.3.jar</path-in-war>
                </library>
            </web-module-libraries>
            <web-module-additional-libraries/>
            <source-roots>
                <root id="src.dir"/>
            </source-roots>
            <test-roots>
                <root id="test.src.dir"/>
