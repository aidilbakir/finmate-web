            <name>FinMate Financial Website</name>
            <minimum-ant-version>1.6.5</minimum-ant-version>
            <web-module-libraries>
                <library dirs="200">
                    <file>${file.reference.gson-2.10.1.jar}</file>
                    <path-in-war>WEB-INF/lib/gson-2.10.1.jar</path-in-war>
                </library>
                <library dirs="200">
                    <file>${file.reference.HikariCP-5.0.1.jar}</file>
                    <path-in-war>WEB-INF/lib/HikariCP-5.0.1.jar</path-in-war>
                </library>
                <library dirs="200">
                    <file>${file.reference.slf4j-api-2.0.7.jar}</file>
                    <path-in-war>WEB-INF/lib/slf4j-api-2.0.7.jar</path-in-war>
                </library>
                <library dirs="200">
                    <file>${file.reference.slf4j-simple-2.0.7.jar}</file>
                    <path-in-war>WEB-INF/lib/slf4j-simple-2.0.7.jar</path-in-war>
                </library>
                <library dirs="200">
                    <file>${file.reference.jbcrypt-0.4.jar}</file>
