# Environment Configuration Template
# Copy this file to .env and update the values

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finmate
DB_USER=root
DB_PASSWORD=
# ^ CHANGE THIS: Your MySQL root password

# JWT Configuration
JWT_SECRET=
# ^ CHANGE THIS: Random string minimal 32 characters untuk signing JWT tokens
# Generate: openssl rand -base64 32
# Example: a7f3d9e2b8c4f1a6e9d2b5c8f3a6e9d2b5c8f3a6e9d2

JWT_EXPIRATION_MS=86400000
# ^ Token expiration time in milliseconds (default: 24 hours)
# 1 hour = 3600000, 24 hours = 86400000, 7 days = 604800000

# Application Configuration
APP_ENV=development
# ^ Options: development, production

SERVER_PORT=8080
# ^ Tomcat server port (usually 8080)

# SECURITY NOTES:
# 1. NEVER commit .env file to Git (already in .gitignore)
# 2. Use different JWT_SECRET for production
# 3. Keep DB_PASSWORD secure
# 4. Rotate JWT_SECRET periodically in production
